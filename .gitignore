# ---------------------------------------------------------------
# Python (backend, pipeline, spikes)
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Jupyter (handy for spikes; outputs can get large)
.ipynb_checkpoints/

# ---------------------------------------------------------------
# Node (frontend)
# ---------------------------------------------------------------
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------
# Secrets: never commit these. Document variables in .env.example.
# ---------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# AWS SAM build output (samconfig.toml stays tracked)
# ---------------------------------------------------------------
.aws-sam/

# ---------------------------------------------------------------
# Audio & model files: the app never stores audio (README §2),
# and test clips / downloaded weights don't belong in git.
# ---------------------------------------------------------------
*.wav
*.mp3
*.m4a
*.webm
*.opus
*.flac
*.ogg
*.mid
*.midi
*.th
*.pt
*.onnx

# Spike scratch output
spikes/**/output/

# ---------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.log
